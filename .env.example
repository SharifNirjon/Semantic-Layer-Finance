# --- Warehouse ---
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank_demo_pw
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# --- Cube ---
JWT_SECRET=change-me-demo-secret-at-least-32-chars-long
CUBE_PORT=4000

# --- MCP server ---
MCP_PORT=8765

# --- Agent API ---
API_PORT=8000
LLM_PROVIDER=gemini            # gemini | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Web ---
WEB_PORT=3000

# --- Data ---
REFERENCE_DATE=2026-09-30

# --- Build mirrors (optional; leave default unless pypi.org is blocked on your network) ---
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# --- Production on a VPS (set by deploy/deploy.sh; leave unset for local use) ---
# COMPOSE_FILE='docker-compose.yml:deploy/docker-compose.prod.yml'
# DOMAIN=analytics.example.com            # DNS A record -> the server; Caddy gets the HTTPS certificate
# SITE_USER=demo                          # password gate in front of the whole site
# SITE_PASSWORD_HASH=                     # bcrypt, from: docker run --rm caddy:2.10 caddy hash-password
